# Copy to .env and fill in. .env is gitignored, never commit your key.

# Your model provider key (OpenAI shown; adapt for your provider).
OPENAI_API_KEY=sk-...

# Model + bounds. These ARE your M5 deliverable, tune and justify them.
CORTEX_MODEL=gpt-4o-mini      # use a cheap, fast model; a full run is ~cents
CORTEX_MAX_ITERATIONS=8       # loop cap: stop + escalate instead of spinning
CORTEX_MAX_REVISIONS=2        # critic<->drafter cap: stop the bounce-forever bomb
CORTEX_COST_CAP_USD=0.15      # hard spend cap per run, enforced outside the model
CORTEX_MAX_QUEUE_ITEMS=10     # commitment cap: max backlog stories queued per run
CORTEX_RUN_DEADLINE_S=120     # total time cap per run: gives up with a failure note
CORTEX_CALL_TIMEOUT_S=30      # per model call (drafter and critic); a hung call never reaches the loop
CORTEX_CALL_RETRIES=1         # retries per call (timeouts, connection errors, 429s, 5xx), then give up
# Kill switch (not an env var): create 00-build/STOP to halt any run at its next step; delete it to resume.

# Rough $ per 1M tokens for your chosen model (for the in-code cost estimate).
CORTEX_PRICE_IN_PER_M=0.15
CORTEX_PRICE_OUT_PER_M=0.60

# The critic uses a stronger model than the drafter (a critic as weak as the drafter
# can't catch its mistakes). Priced separately so the cost cap sees the real spend.
CORTEX_CRITIC_MODEL=gpt-4o
CORTEX_CRITIC_PRICE_IN_PER_M=2.50
CORTEX_CRITIC_PRICE_OUT_PER_M=10.00
